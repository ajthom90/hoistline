# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# --- Hub settings ---

# Required. The hub's public https URL, no trailing slash (the Cloudflare Tunnel hostname).
# It is the OAuth issuer, and the login callback is <PUBLIC_URL>/oauth/callback.
PUBLIC_URL=https://hoistline.example.com

# GitHub login (the default). Create a GitHub OAuth app with the callback URL above.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generic OIDC login instead of GitHub. Set all three or none; when set, the GitHub variables are not used.
# Register <PUBLIC_URL>/oauth/callback as the redirect URI at the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Who may sign in, comma-separated typed entries:
#   github-id:<numeric id>  (recommended for GitHub)   github:<login>
#   email:<verified OIDC email>                         sub:<OIDC subject>
# When empty, ANY GitHub (or OIDC) account can sign in and use the hub with its own machines.
HOISTLINE_ALLOWED_USERS=

# Set by the image; change only when running the hub outside Docker.
#   PORT=3000                          port the hub listens on (inside the container)
#   DATABASE_PATH=/data/hoistline.db   SQLite file (outside Docker the default is ./data/hoistline.db)

# --- Compose settings (read by docker-compose.yml, not by the hub) ---

# Host port the hub is published on, on 127.0.0.1 only.
HUB_PORT=3000
# Host directory for the database (must be writable by uid 10001).
HUB_DATA_DIR=./data
# Image to run.
HUB_IMAGE=ghcr.io/ajthom90/hoistline-hub:latest

# Only for the optional cloudflared service in docker-compose.yml.
# TUNNEL_TOKEN=
